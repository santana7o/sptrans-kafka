# Configuracao do pipeline (copie para .env; "make up" faz isso automaticamente).
# Referencia: docs/CONTRACTS.md, secao 6. Nunca versione o .env.
#
# Dentro do docker compose, KAFKA_BOOTSTRAP_SERVERS, POSTGRES_HOST e POSTGRES_PORT
# sao sobrescritos para os nomes internos (kafka:19092, postgres:5432). Os valores
# abaixo valem para rodar os modulos direto no host (.venv).

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
# Modo do producer: "replay" (reproduz data/samples, nao exige token) ou "live" (API Olho Vivo)
MODE=replay
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# Endereco do broker visto do host (no compose: kafka:19092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topico das posicoes brutas (BusPosition)
TOPIC_RAW=bus-positions-raw
# Topico das metricas por linha (LineMetric)
TOPIC_METRICS=bus-metrics
# Topico dos alertas de onibus parado (BusAlert)
TOPIC_ALERTS=bus-alerts

# ---------------------------------------------------------------------------
# API Olho Vivo (modo live e gravador)
# ---------------------------------------------------------------------------
# Token pessoal da SPTrans: obrigatorio para "make live" e "make record". Deixe vazio no replay.
SPTRANS_TOKEN=
# URL base da API
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
# Intervalo entre coletas no modo live (segundos)
POLL_INTERVAL_SECONDS=30
# Timeout de cada requisicao HTTP (segundos)
HTTP_TIMEOUT_SECONDS=20
# Tentativas por requisicao, com backoff exponencial
HTTP_MAX_RETRIES=5

# ---------------------------------------------------------------------------
# Replay e gravacao de samples
# ---------------------------------------------------------------------------
# Arquivo reproduzido no modo replay (caminho relativo a raiz do projeto)
REPLAY_FILE=data/samples/sample_synthetic.jsonl.gz
# Fator de aceleracao do replay (1 = tempo real)
REPLAY_SPEED=5
# Recomeca o arquivo ao terminar (true/false)
REPLAY_LOOP=true
# Desloca os timestamps para "agora" e soma a duracao do arquivo a cada volta (true/false)
REPLAY_REBASE_TIMESTAMPS=true
# Pasta de destino do gravador (make record)
RECORD_OUTPUT_DIR=data/samples
# Quantidade de coletas gravadas pelo gravador
RECORD_COLLECTIONS=20

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Host do banco visto do host (no compose: postgres)
POSTGRES_HOST=localhost
# Porta do banco vista do host (no compose: 5432)
POSTGRES_PORT=5432
# Nome do banco
POSTGRES_DB=sptrans
# Usuario do banco
POSTGRES_USER=sptrans
# Senha do banco (apenas para desenvolvimento local)
POSTGRES_PASSWORD=sptrans

# ---------------------------------------------------------------------------
# Consumer de persistencia
# ---------------------------------------------------------------------------
# Quantidade de mensagens por lote gravado
PERSISTENCE_BATCH_SIZE=500
# Grava o lote apos este tempo mesmo que nao esteja cheio (segundos)
PERSISTENCE_FLUSH_SECONDS=2

# ---------------------------------------------------------------------------
# Regras de processamento (metricas e alertas, em tempo de evento)
# ---------------------------------------------------------------------------
# Tamanho da janela de metricas (minutos; divisor de 60)
WINDOW_MINUTES=5
# Atraso tolerado antes de fechar uma janela (segundos)
WINDOW_LATENESS_SECONDS=60
# Fecha as janelas abertas apos este tempo sem mensagens (segundos)
IDLE_FLUSH_SECONDS=120
# Velocidade acima disso e descartada como ruido de GPS (km/h)
MAX_SPEED_KMH=100
# Intervalo minimo valido entre duas leituras do mesmo veiculo (segundos)
MIN_INTERVAL_SECONDS=1
# Intervalo maximo valido entre duas leituras do mesmo veiculo (segundos)
MAX_INTERVAL_SECONDS=600
# Abaixo desta velocidade o onibus e considerado parado (km/h)
ALERT_SPEED_KMH=2
# Tempo parado fora de terminal para gerar alerta (minutos)
ALERT_MIN_MINUTES=10
# Raio em torno dos terminais em que paradas nao geram alerta (metros)
TERMINAL_RADIUS_M=400

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Intervalo de atualizacao do dashboard (segundos)
DASHBOARD_REFRESH_SECONDS=30

# ---------------------------------------------------------------------------
# Somente docker compose (opcional)
# ---------------------------------------------------------------------------
# Porta do PostgreSQL publicada no host; mude se a 5432 ja estiver em uso
# (lembre de ajustar POSTGRES_PORT acima para rodar modulos pelo host)
POSTGRES_HOST_PORT=5432
